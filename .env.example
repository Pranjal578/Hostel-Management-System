# =========================================================================
# Hostel Resident Management System - Environment Variables Example File
# Copy this file to '.env' and fill in your actual credentials.
# =========================================================================

# Application Configuration (development / production)
FLASK_ENV=development
SECRET_KEY=generate-a-secure-random-hex-for-production
BASE_URL=http://127.0.0.1:5000

# Security - AES-256 Fernet Encryption Key for PII Fields (32 URL-safe base64-encoded bytes)
# You can generate a key using: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=your-32-byte-base64-fernet-key

# Default SuperAdmin access
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-something-secure

# Google OAuth 2.0 Integration (Sign-In)
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# Email Integration (Flask-Mail / SMTP, e.g., SendGrid/Gmail)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-specific-email-password
SENDER_EMAIL=noreply@hostelmanagement.com

# Twilio SMS Integration (Optional OTP Delivery)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=your-twilio-phone-number
