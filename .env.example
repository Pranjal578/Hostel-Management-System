# =========================================================================
# Hostel Resident Management SaaS Platform - Environment Variables Template
# Copy this file to '.env' and fill in your actual credentials.
# =========================================================================

# 1. Flask Core Settings
FLASK_ENV=development
SECRET_KEY=generate-a-secure-random-hex-for-production
BASE_URL=http://127.0.0.1:5000
FLASK_HOST=0.0.0.0
FLASK_PORT=5000

# 2. Database & Data Security (AES-256 Fernet Encryption Key)
# Generate a key using: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=your-32-byte-base64-fernet-key

# Production Database URI (PostgreSQL or SQLite fallback)
# On DigitalOcean, this will be automatically generated and injected into the container.
# SQLite format: sqlite:///instance/database.db
# PostgreSQL format: postgresql://username:password@hostname:5432/databasename
# DATABASE_URL=postgresql://username:password@localhost:5432/hostel_db

# 3. Default SuperAdmin Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-something-secure

# 4. Google OAuth 2.0 Credentials (Federated Sign-In)
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# 5. SMTP/Email Configurations (OTP Verification Support)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-specific-email-password
SENDER_EMAIL=noreply@hostelmanagement.com

# 6. Twilio SMS Integrations (Optional SMS OTP Delivery)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=your-twilio-phone-number
