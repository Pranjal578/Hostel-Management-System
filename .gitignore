# =========================================================================
# Hostel Resident Management SaaS - Git Exclusions Config
# =========================================================================

# 1. Python Cache & Compilation Logs
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# 2. Virtual Environments
venv/
ENV/
env/
.venv/
pip-selfcheck.json

# 3. SQLite Databases & Local Storage
instance/
.webassets-cache
*.db
database.db

# 4. IDE / Project Settings & Workspace Configs
.vscode/
.idea/
*.swp
*.swo
*~
.project
.pydevproject
.settings/

# 5. OS-Generated Files
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini

# 6. Local Dynamic Resident Media Assets (Ignore generated QRs and Profile Pictures)
app/static/qr/*.png
app/static/images/resident_*.png
app/static/images/resident_*.jpg
app/static/images/resident_*.jpeg

# Preserve directory existence in VCS
!app/static/qr/.gitkeep
!app/static/images/.gitkeep

# 7. Environment Variables & Secrets
.env
.env.local
.env.*.local
.env.production
.env.staging
.env.development

# 8. Temporary & Backup Files
*.tmp
*.temp
*.bak
